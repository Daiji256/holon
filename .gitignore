# Temporary & scratch directories
tmp/
scratch/

# Generated fonts (do not commit until finished)
*.ttf
*.otf
*.woff
*.woff2
fonts/

# Visual specimens and preview images (do not commit during development)
specimens/
*.png
*.jpg
*.jpeg
*.svg
*.webp

# HTML test previews (do not commit)
*.html

# OFL.txt (committed only when fonts are committed)
OFL.txt

# Python artifacts
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# OS artifacts
.DS_Store
